# Placeholders que o autor ainda vai trocar pelos perfis reais
^https://www\.linkedin\.com/?$
^https://github\.com/?$

# LinkedIn bloqueia robôs e scrapers do CI com status 999
https://([a-z0-9]+\.)?linkedin\.com/.*

# Exemplos de repositório do "Comece em 5 minutos"
github\.com/<
https://github\.com/<.*

